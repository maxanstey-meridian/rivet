{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rivet-contract-schema.json",
  "title": "Rivet Contract",
  "type": "object",
  "properties": {
    "types": { "type": "array", "items": { "$ref": "#/$defs/typeDefinition" } },
    "enums": { "type": "array", "items": { "$ref": "#/$defs/contractEnum" } },
    "endpoints": { "type": "array", "items": { "$ref": "#/$defs/endpointDefinition" } },
    "security": {
      "$ref": "#/$defs/securityRequirements",
      "description": "The document's security: what every operation without its own security needs, written as the document's root security. Absent leaves the default to --security (its first scheme); no alternatives is security: []. The schemes themselves are defined with --security."
    }
  },
  "required": ["types", "enums", "endpoints"],
  "additionalProperties": false,
  "$defs": {
    "tsType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "primitive" },
            "type": { "type": "string" },
            "format": { "type": "string" },
            "csharpType": { "type": "string" }
          },
          "required": ["kind", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "nullable" },
            "inner": { "$ref": "#/$defs/tsType" }
          },
          "required": ["kind", "inner"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "array" },
            "element": { "$ref": "#/$defs/tsType" },
            "elementMetadata": { "$ref": "#/$defs/scalarMetadata" }
          },
          "required": ["kind", "element"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "dictionary" },
            "value": { "$ref": "#/$defs/tsType" },
            "key": { "$ref": "#/$defs/tsType" },
            "valueMetadata": { "$ref": "#/$defs/scalarMetadata" }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "stringUnion" },
            "namingPolicy": { "type": "string" },
            "values": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "format": { "type": "string" },
            "description": { "type": "string" },
            "metadata": { "$ref": "#/$defs/typeMetadata" },
            "scalarMetadata": { "$ref": "#/$defs/scalarMetadata" }
          },
          "required": ["kind", "values"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "ref" },
            "name": { "type": "string" }
          },
          "required": ["kind", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "generic" },
            "name": { "type": "string" },
            "typeArgs": { "type": "array", "items": { "$ref": "#/$defs/tsType" } }
          },
          "required": ["kind", "name", "typeArgs"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "typeParam" },
            "name": { "type": "string" }
          },
          "required": ["kind", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "brand" },
            "name": { "type": "string" },
            "underlying": { "$ref": "#/$defs/tsType" },
            "description": { "type": "string" },
            "metadata": { "$ref": "#/$defs/typeMetadata" }
          },
          "required": ["kind", "name", "underlying"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "intUnion" },
            "values": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
            "format": { "type": "string" },
            "description": { "type": "string" },
            "metadata": { "$ref": "#/$defs/typeMetadata" },
            "scalarMetadata": { "$ref": "#/$defs/scalarMetadata" }
          },
          "required": ["kind", "values"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "literal" },
            "value": { "type": ["string", "number", "boolean"] }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "inlineObject" },
            "properties": { "type": "array", "items": { "$ref": "#/$defs/tsPropertyDefinition" } },
            "additionalProperties": {
              "type": "boolean",
              "description": "Whether the object takes members beyond its properties: true for an extension-data bag (emitted as additionalProperties: {}), false when unknown members are refused (additionalProperties: false). Absent says neither."
            }
          },
          "required": ["kind", "properties"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "taggedUnion" },
            "discriminator": { "type": "string" },
            "variants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                  "properties": {
                    "tag": { "type": "string" },
                    "type": { "$ref": "#/$defs/tsType" },
                    "metadata": { "$ref": "#/$defs/typeMetadata" },
                    "description": { "type": "string" },
                    "scalarMetadata": { "$ref": "#/$defs/scalarMetadata" },
                    "discriminatorSchema": { "type": "string", "description": "The JSON of the variant's tag property schema as the source authored it, emitted in place of enum: [tag]. A JSON object that admits the tag; like description and scalarMetadata, it needs an inlineObject variant carrying the discriminator property." }
                },
                "required": ["tag", "type"],
                "additionalProperties": false
              }
            }
          },
          "required": ["kind", "discriminator", "variants"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "union" },
            "variants": {
              "type": "array",
              "items": { "$ref": "#/$defs/tsType" },
              "minItems": 1
            }
          },
          "required": ["kind", "variants"],
          "additionalProperties": false
        }
      ]
    },
    "typeMetadata": {
      "type": "object",
      "properties": {
        "componentId": { "type": ["string", "null"] },
        "provenance": { "type": "string", "enum": ["component", "synthetic"] }
      },
      "required": ["provenance"],
      "additionalProperties": false
    },
    "tsPropertyConstraints": {
      "type": "object",
      "properties": {
        "minLength": { "type": "integer" },
        "maxLength": { "type": "integer" },
        "pattern": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "exclusiveMinimum": { "type": "number" },
        "exclusiveMaximum": { "type": "number" },
        "multipleOf": { "type": "number" },
        "minItems": { "type": "integer" },
        "maxItems": { "type": "integer" },
        "uniqueItems": { "type": "boolean" },
        "minProperties": { "type": "integer" },
        "maxProperties": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "scalarMetadata": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "defaultValue": { "type": "string" },
        "example": { "type": "string" },
        "examples": { "type": "string" },
        "isDeprecated": { "type": "boolean" },
        "isReadOnly": { "type": "boolean" },
        "isWriteOnly": { "type": "boolean" },
        "constraints": { "$ref": "#/$defs/tsPropertyConstraints" },
        "isNullable": { "type": "boolean" },
        "title": { "type": "string" },
        "xml": { "$ref": "#/$defs/schemaXmlMetadata" },
        "format": { "type": "string" },
        "isFormatSpecified": { "type": "boolean" },
        "required": { "type": "array", "items": { "type": "string" } },
        "enum": { "type": "string", "description": "An enum the C# type cannot spell (booleans, numbers, arrays, objects, null), as a JSON array." },
        "enumListsNull": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "schemaXmlMetadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "prefix": { "type": "string" },
        "isAttribute": { "type": "boolean" },
        "isWrapped": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "tsPropertyDefinition": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/tsType" },
        "optional": { "type": "boolean", "description": "Whether a writer may leave the property out. Absent reads as false: the property is required, and a nullable type alone never makes it optional." },
        "deprecated": { "type": "boolean" },
        "format": { "type": "string" },
        "defaultValue": { "type": "string" },
        "constraints": { "$ref": "#/$defs/tsPropertyConstraints" },
        "description": { "type": "string" },
        "example": { "type": "string" },
        "readOnly": { "type": "boolean" },
        "writeOnly": { "type": "boolean" },
        "scalarMetadata": { "$ref": "#/$defs/scalarMetadata" }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    },
    "typeDefinition": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "typeParameters": { "type": "array", "items": { "type": "string" } },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/tsPropertyDefinition" } },
        "type": { "$ref": "#/$defs/tsType" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/typeMetadata" },
        "scalarMetadata": { "$ref": "#/$defs/scalarMetadata" },
        "additionalProperties": {
          "type": "boolean",
          "description": "Whether an object type takes members beyond its properties: true for an extension-data bag (emitted as additionalProperties: {}), false when unknown members are refused (additionalProperties: false). Absent says neither. Object types only, never an alias."
        }
      },
      "required": ["name", "typeParameters"],
      "oneOf": [
        { "required": ["properties"] },
        { "required": ["type"] }
      ],
      "dependentSchemas": {
        "additionalProperties": { "required": ["properties"] }
      },
      "additionalProperties": false
    },
    "contractEnum": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "namingPolicy": { "type": "string" },
            "values": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "format": { "type": "string" },
            "description": { "type": "string" },
            "metadata": { "$ref": "#/$defs/typeMetadata" },
            "scalarMetadata": { "$ref": "#/$defs/scalarMetadata" }
          },
          "required": ["name", "values"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "intValues": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
            "format": { "type": "string" },
            "description": { "type": "string" },
            "metadata": { "$ref": "#/$defs/typeMetadata" },
            "scalarMetadata": { "$ref": "#/$defs/scalarMetadata" }
          },
          "required": ["name", "intValues"],
          "additionalProperties": false
        }
      ]
    },
    "endpointParam": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/tsType" },
        "source": { "type": "string", "enum": ["route", "body", "query", "file", "formField", "header", "cookie"] },
        "isOptional": { "type": "boolean" },
        "bodyPropertyName": { "type": "string", "description": "The input type's property this param carries: on a route param, the body property the route value replaces; on a file or formField param, the property the form part is." },
        "description": { "type": "string" },
        "deprecated": { "type": "boolean" },
        "defaultValue": { "type": "string" },
        "constraints": { "$ref": "#/$defs/tsPropertyConstraints" },
        "schemaExamples": { "type": "array" },
        "example": {},
        "examples": { "type": "object", "additionalProperties": { "type": "object" } },
        "style": { "type": "string", "enum": ["matrix", "label", "form", "simple", "spaceDelimited", "pipeDelimited", "deepObject"] },
        "explode": { "type": "boolean" },
        "schemaType": { "type": "string", "enum": ["string", "integer", "number", "boolean"] },
        "format": { "type": "string" },
        "isFormatSpecified": { "type": "boolean" },
        "allowEmptyValue": { "type": "boolean" },
        "allowReserved": { "type": "boolean" }
      },
      "required": ["name", "type", "source"],
      "additionalProperties": false
    },
    "endpointExample": {
      "type": "object",
      "properties": {
        "mediaType": { "type": "string" },
        "name": { "type": "string" },
        "json": { "type": "string" },
        "componentExampleId": { "type": "string" },
        "resolvedJson": { "type": "string" },
        "referencedComponents": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "summary": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["mediaType"],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["json"],
          "not": {
            "anyOf": [
              { "required": ["componentExampleId"] },
              { "required": ["resolvedJson"] }
            ]
          }
        },
        {
          "required": ["componentExampleId"],
          "not": { "required": ["json"] }
        },
        {
          "anyOf": [{ "required": ["summary"] }, { "required": ["description"] }],
          "not": {
            "anyOf": [
              { "required": ["json"] },
              { "required": ["componentExampleId"] },
              { "required": ["resolvedJson"] }
            ]
          }
        }
      ]
    },
    "responseType": {
      "type": "object",
      "properties": {
        "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
        "statusKey": { "type": "string", "pattern": "^(default|[1-5](?:[0-9]{2}|[Xx]{2}))$" },
        "dataType": { "$ref": "#/$defs/tsType" },
        "description": { "type": "string" },
        "examples": { "type": "array", "items": { "$ref": "#/$defs/endpointExample" } },
        "headers": { "type": "array", "items": { "$ref": "#/$defs/responseHeader" } },
        "contents": { "type": "array", "items": { "$ref": "#/$defs/mediaTypeContent" } }
      },
      "anyOf": [
        { "required": ["statusCode"] },
        { "required": ["statusKey"] }
      ],
      "additionalProperties": false
    },
    "responseHeader": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/tsType" },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "deprecated": { "type": "boolean" },
        "schemaExamples": { "type": "array" },
        "example": {},
        "examples": { "type": "object", "additionalProperties": { "type": "object" } },
        "style": { "type": "string", "enum": ["matrix", "label", "form", "simple", "spaceDelimited", "pipeDelimited", "deepObject"] },
        "explode": { "type": "boolean" },
        "allowReserved": { "type": "boolean" },
        "allowEmptyValue": { "type": "boolean" },
        "contentType": { "type": "string" }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    },
    "securityRequirements": {
      "description": "OpenAPI security requirements: any one alternative satisfies them; an alternative needs every scheme in it. Absent inherits the document's security; no alternatives is security: []; an alternative with no schemes makes credentials optional.",
      "type": "object",
      "properties": {
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schemes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "scopes": { "type": "array", "items": { "type": "string" } }
                  },
                  "required": ["name", "scopes"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["schemes"],
            "additionalProperties": false
          }
        }
      },
      "required": ["alternatives"],
      "additionalProperties": false
    },
    "operationProvenance": {
      "type": "object",
      "properties": {
        "operationIdPresent": { "type": "boolean" },
        "operationId": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "deprecated": { "type": "boolean" },
        "serverOverride": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "description": { "type": ["string", "null"] },
              "variables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "defaultValue": { "type": "string" },
                    "allowedValues": { "type": "array", "items": { "type": "string" } },
                    "description": { "type": ["string", "null"] }
                  },
                  "required": ["name", "defaultValue", "allowedValues"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["url", "variables"],
            "additionalProperties": false
          }
        },
        "requestBodyDescription": { "type": ["string", "null"] },
        "requestBodyComponentId": { "type": ["string", "null"] },
        "rivetIdentity": {
          "type": ["object", "null"],
          "properties": {
            "contract": { "type": ["string", "null"] },
            "endpoint": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "parameterComponentReferences": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "location": { "type": "string" },
              "componentId": { "type": "string" }
            },
            "required": ["name", "location", "componentId"],
            "additionalProperties": false
          }
        },
        "responseComponentReferences": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "statusKey": { "type": "string" },
              "componentId": { "type": "string" }
            },
            "required": ["statusKey", "componentId"],
            "additionalProperties": false
          }
        },
        "responseHeaderComponentReferences": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "statusKey": { "type": "string" },
              "headerName": { "type": "string" },
              "componentId": { "type": "string" }
            },
            "required": ["statusKey", "headerName", "componentId"],
            "additionalProperties": false
          }
        },
        "schemas": {
          "type": ["object", "null"],
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "location": { "type": "string" },
                  "json": { "type": "string" }
                },
                "required": ["name", "location", "json"],
                "additionalProperties": false
              }
            },
            "requests": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "mediaType": { "type": "string" },
                  "json": { "type": "string" }
                },
                "required": ["mediaType", "json"],
                "additionalProperties": false
              }
            },
            "responses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "statusKey": { "type": "string" },
                  "mediaType": { "type": "string" },
                  "json": { "type": "string" }
                },
                "required": ["statusKey", "mediaType", "json"],
                "additionalProperties": false
              }
            }
          },
          "required": ["parameters", "requests", "responses"],
          "additionalProperties": false
        }
      },
      "required": ["operationIdPresent", "tags", "deprecated"],
      "additionalProperties": false
    },
    "queryAuth": {
      "type": "object",
      "properties": {
        "parameterName": { "type": "string" }
      },
      "required": ["parameterName"],
      "additionalProperties": false
    },
    "mediaTypeContent": {
      "type": "object",
      "properties": {
        "mediaType": { "type": "string" },
        "schema": { "$ref": "#/$defs/tsType" },
        "isBinary": { "type": "boolean" },
        "schemaType": { "type": "string", "enum": ["string", "integer", "number", "boolean"] },
        "format": { "type": "string" },
        "isFormatSpecified": { "type": "boolean" },
        "schemaDescription": { "type": "string" }
      },
      "required": ["mediaType"],
      "additionalProperties": false
    },
    "endpointDefinition": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "httpMethod": { "type": "string", "enum": ["GET", "HEAD", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"] },
        "routeTemplate": { "type": "string", "description": "The OpenAPI path key, written as is: each token is bare ({id}) and typed by its path param. ASP.NET routing syntax in a token (a constraint {id:int}, the optional marker {id?}, a default {page=1} or a catch-all {*path}) is refused with RIV2017." },
        "params": { "type": "array", "items": { "$ref": "#/$defs/endpointParam" } },
        "returnType": { "$ref": "#/$defs/tsType" },
        "controllerName": { "type": "string" },
        "responses": { "type": "array", "items": { "$ref": "#/$defs/responseType" } },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "security": { "$ref": "#/$defs/securityRequirements" },
        "fileContentType": { "type": "string" },
        "inputTypeName": { "type": "string", "description": "The name of the endpoint's input type. When types carries its definition and every file and formField param names its property (bodyPropertyName), the form body is a $ref to it if its request properties are exactly those params under the same names, and is otherwise inline with each part taking its property's schema. When the params name no properties, a multipart body is a $ref to the definition; without one, the name is only a hint for the inline body built from params (rivet-ts deliberately ships no multipart input type)." },
        "isFormEncoded": { "type": "boolean" },
        "requestType": { "$ref": "#/$defs/tsType" },
        "requestExamples": { "type": "array", "items": { "$ref": "#/$defs/endpointExample" } },
        "isFileEndpoint": { "type": "boolean" },
        "queryAuth": { "$ref": "#/$defs/queryAuth" },
        "binaryRequestContentType": { "type": "string" },
        "requestContentTypeOverride": { "type": "string" },
        "responseContentTypeOverride": { "type": "string" },
        "requestContents": { "type": "array", "items": { "$ref": "#/$defs/mediaTypeContent" } },
        "requestBodyRequired": { "type": "boolean" },
        "requestBodyPresent": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/operationProvenance" }
      },
      "required": ["name", "httpMethod", "routeTemplate", "params", "controllerName", "responses"],
      "additionalProperties": false
    }
  }
}
